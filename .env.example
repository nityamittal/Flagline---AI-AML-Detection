# Local: matches docker-compose.yml. Production: Neon pooled (-pooler host) and direct strings.
DATABASE_URL="postgresql://flagline:flagline@localhost:5432/flagline"
DIRECT_URL="postgresql://flagline:flagline@localhost:5432/flagline"

# Auth.js, for admin sign-in only. Leave all three empty to run as a guest-only demo.
# Generate the secret with: npx auth secret
AUTH_SECRET=
# Only for `next start` on your machine; Vercel sets this automatically.
# AUTH_TRUST_HOST=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_USERNAMES=

# LLM: ollama | openai-compatible | none
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
# Optional; falls back to the template after this many milliseconds (default 8000).
# LLM_TIMEOUT_MS=8000

GUEST_SESSION_TTL_DAYS=7
CRON_SECRET=
